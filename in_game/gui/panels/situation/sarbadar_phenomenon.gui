# The Sarbadar Phenomenon - situation panel.
#
# No single protagonist: the network is the protagonist, so the header is
# the illustration alone, as in base black_death.gui / great_pestilence.gui
# (which never pull a country template into situation_panel_image). The
# block below is the default from base panels/situation/common.gui:117
# with a fixed texture.
#
# The old version used one_country_header_template with the CountryContext
# block overridden to "visible = no". That left the template's portrait
# frame and ruler plate with NO Country/Character datacontext at all, and
# every expression inside them (Character.GetPortrait, Character.IsAlive,
# Character.HasRebel, Country.GetGovernment ...) logged "No context
# supplied" plus "FetchData failed" on every frame the panel was open,
# rotating error.log within minutes.

situation_panel = {

	##################################### TOP HEADER #####################################

	blockoverride "situation_header_left_size" {
		maximumsize = { 260 28 }
	}

	blockoverride "situation_header_left" {
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				layoutpolicy_horizontal = expanding
				text = "sarbadar_preachers"
				default_format = "#subtle_name"
				tooltip = "sarbadar_phenomenon_desc"
			}
		}
		expand = {}
	}

	##################################### MAIN IMAGE #####################################

	blockoverride "situation_panel_image" {
		background = {
			texture = "gfx/interface/illustrations/situation/sarbadar_phenomenon.dds" # Placeholder (copy of eranzamin art)
		}

		using = scene_fade_vertical_up
	}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
			blockoverride "visible_hint" {}
		}
	}
}
