# Ulus Chaghatay IO panel — the khan, the succession, the amirs.
#
# Engine hook: a file named after the IO key in panels/organization/
# overrides the theme for that IO (base ilkhanate.gui, middle_kingdom.gui;
# the mod's eranzamin.gui).
#
# Unlike Erānzamīn this IO HAS a leader country, so base common_header.gui
# draws the header by itself: the leader's country_header (ruler portrait,
# flag, the ULUS_CHAGHATAY_KHAN title) over
# InternationalOrganizationsView.GetIllustration
# (gfx/interface/illustrations/international_organization_types/
# ulus_chaghatay.dds), with the ios_information_header strip listing the
# IO variables declared in ulus_chaghatay.txt (amirs / weight of the begs
# / amirs to khan). Nothing in the header is overridden here.
#
# Data: every card reads the monthly ledger built by
# ulus_chaghatay_rebuild_ledger (scripted_effects/14_ulus_chaghatay_effects.txt).
#
# EVERY construction below is one already running in eranzamin.gui — read
# the comments there before changing anything; they were paid for with
# crashes:
#   - lists only through GetGlobalList, ONE level deep (no list inside a
#     list item);
#   - a list item is a FIXED-SIZE widget with
#     datacontext = "[Scope.GetCountry]", reading per-country variables as
#     Country.MakeScope.GetVariable(...), positioned absolutely (no
#     hbox/expand inside a grid item);
#   - IO variables as InternationalOrganizationsView.
#     GetInternationalOrganization.MakeScope.GetVariable(...), a character
#     through .GetCharacter (the eranzamin_held_khan read), a number
#     through .GetValue, a bar through FixedPointToFloat;
#   - cards are base card_common.
# The leader country is read as ...GetInternationalOrganization.
# GetLeaderCountry / IsLeaderCountryInPlace (base common_header.gui,
# middle_kingdom.gui).
#
# Tabs: Overview (the three cards, then the engine's special-member
# groups) and Members (engine, grouped by the Amir of the Ulus status in
# international_organization_special_statuses/ulus_chaghatay.txt).
#
# The Succession card has two faces, switched on the IO variable
# ulus_regency: while a khan rules, the regency bar and the kingmakers;
# during the Amirs' Regency, the regent and the khan he holds, the
# heir's standing against the line, the legitimacy gap and the stage.
# All of it is IO variables written by the ledger (section 6) and by
# scripted_effects/15_amirs_regency_effects.txt.

organization_geodiplomatic_theme = {

	# ---TABS (as base ilkhanate.gui: force the Overview on) -------------
	blockoverride "organization_overview_tab_visible" {}
	blockoverride "organization_panel_overview_visible" {
		visible = "[InternationalOrganizationsView.Vars.NotExistOrHasValue( 'organizations', 'overview' )]"
	}
	blockoverride "organization_members_tab_down" {
		down = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}
	blockoverride "organization_panel_members_visible" {
		visible = "[InternationalOrganizationsView.Vars.HasValue( 'organizations', 'members' )]"
	}
	blockoverride "scroll_overview_empty_visible" { visible = no }

	blockoverride "io_main_actions_icon" {
		texture = "[InternationalOrganizationsView.GetInternationalOrganization.GetIcon]"
	}

	# ---OVERVIEW: three cards above the engine's special-member groups --
	blockoverride "organization_overview_list_custom_top_extra" {

		# (1) THE KHAN — the seat of the ulus, the man on it, and his heir
		# as the realm's own succession law names him (the törü once it is
		# seated on CHG; tribal_oldest_male until then).
		card_common = {
			blockoverride "header_decor_templates" {
				using = bg_card_header_01_geopolitics
				using = bg_cabinet_card_frame
			}
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/great_power_score.dds"
			}
			blockoverride "common_header_text" {
				text = "ULUS_KHAN_CARD"
			}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 4
					tooltip = "ULUS_KHAN_CARD_TT"

					# Seat and ruler. datacontext = the leader Country (the
					# ez_key_city_row construction: a Country datacontext on
					# the hbox, flag and texts reading it).
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[And(InternationalOrganizationsView.GetInternationalOrganization.IsLeaderCountryInPlace, Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet))]"
						datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
						spacing = 8

						country_flag_small = {}
						text_single = {
							size = { 200 24 }
							autoresize = no
							align = left|nobaseline
							text = "[Country.GetName]"
							default_format = "#yellow_titles"
						}
						expand = {}
						text_single = {
							size = { 220 24 }
							autoresize = no
							align = right|nobaseline
							text = "[Country.GetGovernment.GetRulerOrRegent.GetShortNameWithNoTooltip]"
						}
					}

					# ---DURING A REGENCY: the khan is the man who is HELD, not
					# the ruler of the state that leads the ulus. First the
					# khan (ulus_held_khan, a character on the IO), then the
					# state that keeps him and the regent who rules it.
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[And(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet, InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').IsSet)]"
						spacing = 8
						tooltip = "ULUS_HELD_KHAN_TT"

						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/character_roles/ruler.dds"
						}
						text_single = {
							size = { 300 24 }
							autoresize = no
							align = left|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').GetCharacter.GetShortNameWithNoTooltip]"
							default_format = "#yellow_titles"
						}
						expand = {}
						text_single = {
							visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').IsSet]"
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_KHAN_AGE_LABEL"
							default_format = "#subtle_name"
						}
						text_single = {
							visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').IsSet]"
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').GetValue|V0]"
						}
					}
					text_single = {
						visible = "[And(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet, Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').IsSet))]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_NO_HELD_KHAN"
						default_format = "#subtle_name"
						tooltip = "ULUS_HELD_KHAN_TT"
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[And(InternationalOrganizationsView.GetInternationalOrganization.IsLeaderCountryInPlace, InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet)]"
						datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
						spacing = 8
						tooltip = "ULUS_REGENT_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_KEEPING_LABEL"
							default_format = "#subtle_name"
						}
						country_flag_small = {}
						text_single = {
							size = { 110 24 }
							autoresize = no
							align = left|nobaseline
							text = "[Country.GetName]"
						}
						expand = {}
						icon = {
							size = { 22 22 }
							texture = "gfx/interface/icons/character_roles/regent.dds"
						}
						text_single = {
							size = { 150 24 }
							autoresize = no
							align = right|nobaseline
							text = "[Country.GetGovernment.GetRulerOrRegent.GetShortNameWithNoTooltip]"
						}
					}

					# Heir (ulus_khan_heir on the IO, a character).
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_heir').IsSet]"
						spacing = 8

						text_single = {
							visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet)]"
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_HEIR_LABEL"
							default_format = "#subtle_name"
						}
						text_single = {
							visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet]"
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_REGENT_HEIR_LABEL"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							size = { 300 24 }
							autoresize = no
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_heir').GetCharacter.GetShortNameWithNoTooltip]"
						}
					}
					text_single = {
						visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_heir').IsSet)]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_NO_HEIR"
						default_format = "#subtle_name"
					}
				}
			}
		}

		# (2) THE SUCCESSION — the regency bar, and who would take the khan
		# if the throne fell vacant today. Shown at all times, as the
		# Empire's panel shows its next election.
		card_common = {
			blockoverride "header_decor_templates" {
				using = bg_card_header_01_geopolitics
				using = bg_cabinet_card_frame
			}
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/character_roles/regent.dds"
			}
			blockoverride "common_header_text" {
				text = "ULUS_SUCCESSION_CARD"
			}
			blockoverride "common_bottom_content" {
				# Two faces, one card. While a khan rules: the regency bar
				# and the kingmakers. During a regency (ulus_regency set on
				# the IO): the regent and the khan he holds, his heir
				# against the line, the legitimacy gap, the stage. Each is
				# a vbox switched on the IO variable; nothing is nested
				# deeper than the lists already were.
				vbox = {
				layoutpolicy_horizontal = expanding

				# ---DURING A REGENCY ----------------------------------------
				vbox = {
					visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet]"
					layoutpolicy_horizontal = expanding
					spacing = 6

					# The regent: the ruler of the leading state.
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.IsLeaderCountryInPlace]"
						datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
						spacing = 8
						tooltip = "ULUS_REGENT_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_REGENT_LABEL"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							size = { 300 24 }
							autoresize = no
							align = right|nobaseline
							text = "[Country.GetGovernment.GetRulerOrRegent.GetShortNameWithNoTooltip]"
							default_format = "#yellow_titles"
						}
					}

					# The khan he holds, and the khan's age.
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').IsSet]"
						spacing = 8
						tooltip = "ULUS_HELD_KHAN_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_HELD_KHAN_LABEL"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							size = { 240 24 }
							autoresize = no
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').GetCharacter.GetShortNameWithNoTooltip]"
						}
						text_single = {
							visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').IsSet]"
							autoresize = yes
							align = right|nobaseline
							raw_text = ","
						}
						text_single = {
							visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').IsSet]"
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan_age').GetValue|V0]"
						}
					}
					text_single = {
						visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_held_khan').IsSet)]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_NO_HELD_KHAN"
						default_format = "#subtle_name"
						tooltip = "ULUS_HELD_KHAN_TT"
					}

					# The regent's heir against the best rival amir.
					# The keeper's own weight (he is not in the Amirs card, and
					# the khan's-weight row belongs to the other face).
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.IsLeaderCountryInPlace]"
						datacontext = "[InternationalOrganizationsView.GetInternationalOrganization.GetLeaderCountry]"
						spacing = 8
						tooltip = "ULUS_AMIR_ROW_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_KEEPER_WEIGHT"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[Country.MakeScope.GetVariable('ulus_weight_eff').GetValue|1]"
							default_format = "#yellow_titles"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_HEIR_BAR_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_HEIR_BAR"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_heir_standing').GetValue|2]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_heir_line').GetValue|2]"
						}
					}
					progressbar = {
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_green_alt
						min = 0
						max = 1
						value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_heir_bar').GetValue)]"
						direction = horizontal
						tooltip = "ULUS_HEIR_BAR_TT"
					}

					# The legitimacy gap.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_GAP_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_GAP_LABEL"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/ 100"
						}
					}
					progressbar = {
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_green_alt
						min = 0
						max = 1
						value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap_bar').GetValue)]"
						direction = horizontal
						tooltip = "ULUS_GAP_TT"
					}
					# What it loses a month (ulus_gap_drain, written by
					# ulus_regency_gap_tick), and why faster than it might.
					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap_drain').IsSet]"
						spacing = 8
						tooltip = "ULUS_GAP_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_GAP_DRAIN_LABEL"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap_drain').GetValue|2]"
						}
					}
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regent_outweighed').IsSet]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						fontsize = 12
						text = "ULUS_GAP_OUTWEIGHED"
						default_format = "#subtle_name"
						tooltip = "ULUS_GAP_TT"
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_GAP_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_GAP_FILLED_MONTHS"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap_filled_months').GetValue|V0]"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_GAP_EMPTY_MONTHS"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_gap_empty_months').GetValue|V0]"
						}
					}

					# The stage (one of four flags is set by the ledger),
					# its progress, and what the next stage opens.
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_stage_is_1').IsSet]"
						layoutpolicy_horizontal = expanding
						margin_top = 4
						align = left|nobaseline
						text = "ULUS_STAGE_1"
						default_format = "#yellow_titles"
						tooltip = "ULUS_STAGE_1_TT"
					}
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_stage_is_2').IsSet]"
						layoutpolicy_horizontal = expanding
						margin_top = 4
						align = left|nobaseline
						text = "ULUS_STAGE_2"
						default_format = "#yellow_titles"
						tooltip = "ULUS_STAGE_2_TT"
					}
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_stage_is_3').IsSet]"
						layoutpolicy_horizontal = expanding
						margin_top = 4
						align = left|nobaseline
						text = "ULUS_STAGE_3"
						default_format = "#yellow_titles"
						tooltip = "ULUS_STAGE_3_TT"
					}
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_stage_is_4').IsSet]"
						layoutpolicy_horizontal = expanding
						margin_top = 4
						align = left|nobaseline
						text = "ULUS_STAGE_4"
						default_format = "#yellow_titles"
						tooltip = "ULUS_STAGE_4_TT"
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_STAGE_PROGRESS"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency_progress').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/ 100"
						}
					}
				}

				# ---WHILE A KHAN RULES --------------------------------------
				vbox = {
					visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_regency').IsSet)]"
					layoutpolicy_horizontal = expanding
					spacing = 6

					# The begs' weight in the khan's own realm, against 50%.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_BEG_BAR_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_BEG_BAR"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_beg_power').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "% /"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_beg_line').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "%"
						}
					}
					progressbar = {
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_green_alt
						min = 0
						max = 1
						value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_beg_bar').GetValue)]"
						direction = horizontal
						tooltip = "ULUS_BEG_BAR_TT"
					}

					# The crown's power beside the begs': the bar's second
					# condition (begs at least twice the crown).
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_BEG_BAR_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_CROWN_ROW"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_crown_power').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "%, begs need"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_crown_line').GetValue|V0]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "%"
						}
					}

					# The khan's own weight and what it is made of.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin_top = 4
						tooltip = "ULUS_KHAN_WEIGHT_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_KHAN_WEIGHT"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_weight').GetValue|1]"
							default_format = "#yellow_titles"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						tooltip = "ULUS_KHAN_WEIGHT_TT"

						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_WEIGHT_MIL"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_w_mil').GetValue|1]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/ 40,"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_WEIGHT_TAX"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_w_tax').GetValue|1]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/ 30,"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_WEIGHT_RUL"
							default_format = "#subtle_name"
