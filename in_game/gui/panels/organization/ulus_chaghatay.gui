							align = right|nobaseline
							raw_text = "/ 20,"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_WEIGHT_PRE"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_w_pre').GetValue|1]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/ 10"
						}
					}

					# The amirs' combined strength against the khan's, against 2.
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						tooltip = "ULUS_AMIR_BAR_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_AMIR_BAR"
							default_format = "#subtle_name"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_amir_ratio').GetValue|2]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "/"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_amir_line').GetValue|2]"
						}
					}
					progressbar = {
						layoutpolicy_horizontal = expanding
						size = { -1 6 }
						using = progress_bar_green_alt
						min = 0
						max = 1
						value = "[FixedPointToFloat(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_amir_bar').GetValue)]"
						direction = horizontal
						tooltip = "ULUS_AMIR_BAR_TT"
					}

					# The three the bar is about: the greatest amirs BY WEIGHT
					# (global list ulus_greatest_amirs, one level deep, fixed
					# widget items), then the arithmetic in one line:
					# their sum against the khan's weight = the ratio.
					vbox = {
						spacing = 2
						datamodel = "[GetGlobalList('ulus_greatest_amirs')]"
						item = {
							widget = {
								datacontext = "[Scope.GetCountry]"
								size = { 470 26 }
								tooltip = "ULUS_GREATEST_ROW_TT"
								country_flag_small = {
									parentanchor = left|vcenter
								}
								text_single = {
									parentanchor = left|vcenter
									position = { 42 0 }
									size = { 300 24 }
									autoresize = no
									align = left|nobaseline
									text = "[Country.GetName]"
								}
								text_single = {
									visible = "[Country.MakeScope.GetVariable('ulus_weight_eff').IsSet]"
									parentanchor = right|vcenter
									position = { -6 0 }
									size = { 60 24 }
									autoresize = no
									align = right|nobaseline
									text = "[Country.MakeScope.GetVariable('ulus_weight_eff').GetValue|1]"
								}
							}
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						tooltip = "ULUS_AMIR_BAR_TT"

						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_top3_weight').GetValue|1]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_AGAINST"
							default_format = "#subtle_name"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_khan_weight').GetValue|1]"
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							raw_text = "="
						}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_amir_ratio').GetValue|2]"
							default_format = "#yellow_titles"
						}
					}

					# Standing in the ulus: the khan and the three likeliest
					# kingmakers, by kingmaker score (list ulus_standing).
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 6
						tooltip = "ULUS_KINGMAKER_TT"

						text_single = {
							autoresize = yes
							align = left|nobaseline
							text = "ULUS_IF_KHAN_DIED"
							default_format = "#yellow_titles"
						}
						expand = {}
						text_single = {
							autoresize = yes
							align = right|nobaseline
							text = "ULUS_SCORE_HEADER"
							default_format = "#subtle_name"
						}
					}
					text_single = {
						visible = "[IsDataModelEmpty(GetGlobalList('ulus_standing'))]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_NO_KINGMAKERS"
						default_format = "#subtle_name"
					}
					# The three highest kingmaker scores, best first: a vbox
					# over a global list with fixed-size widget items (the
					# Notables-tab heads list of eranzamin.gui).
					vbox = {
						spacing = 2
						datamodel = "[GetGlobalList('ulus_standing')]"
						item = {
							widget = {
								datacontext = "[Scope.GetCountry]"
								size = { 470 30 }
								tooltip = "ULUS_STANDING_ROW_TT"
								country_flag_small = {
									parentanchor = left|vcenter
								}
								text_single = {
									parentanchor = left|vcenter
									position = { 42 0 }
									size = { 170 24 }
									autoresize = no
									align = left|nobaseline
									text = "[Country.GetName]"
								}
								text_single = {
									parentanchor = left|vcenter
									position = { 215 0 }
									size = { 165 24 }
									autoresize = no
									align = left|nobaseline
									fontsize = 12
									text = "[Country.GetGovernment.GetRulerOrRegent.GetShortNameWithNoTooltip]"
									default_format = "#subtle_name"
								}
								# The seat's own row.
								icon = {
									visible = "[Country.MakeScope.GetVariable('ulus_seat_row').IsSet]"
									parentanchor = left|vcenter
									position = { 384 0 }
									size = { 22 22 }
									texture = "gfx/interface/icons/character_roles/ruler.dds"
									tooltip = "ULUS_SEAT_ROW_TT"
								}
								text_single = {
									visible = "[Country.MakeScope.GetVariable('ulus_kingmaker_score').IsSet]"
									parentanchor = right|vcenter
									position = { -6 0 }
									size = { 50 24 }
									autoresize = no
									align = right|nobaseline
									text = "[Country.MakeScope.GetVariable('ulus_kingmaker_score').GetValue|V0]"
									default_format = "#yellow_titles"
								}
							}
						}
					}
					# What the bars above come to today.
					text_single = {
						visible = "[InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_heir_holds').IsSet]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_HEIR_HOLDS"
						default_format = "#subtle_name"
						tooltip = "ULUS_OUTCOME_TT"
					}
					text_single = {
						visible = "[Not(InternationalOrganizationsView.GetInternationalOrganization.MakeScope.GetVariable('ulus_heir_holds').IsSet)]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "ULUS_AMIRS_WOULD_RISE"
						default_format = "#yellow_titles"
						tooltip = "ULUS_OUTCOME_TT"
					}
				}
				}
			}
		}

		# (3) THE AMIRS — every junior member, strongest first, with its
		# share of the amirs' combined strength (the Bloc Rolls grid of
		# eranzamin.gui: flat global list, fixed-size widget items).
		card_common = {
			blockoverride "header_decor_templates" {
				using = bg_card_header_01_brown
				using = bg_cabinet_card_frame
			}
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/flat_icons/country.dds"
			}
			blockoverride "common_header_text" {
				text = "ULUS_AMIRS_CARD"
			}
			blockoverride "common_bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					tooltip = "ULUS_AMIRS_CARD_TT"

					text_single = {
						visible = "[IsDataModelEmpty(GetGlobalList('ulus_amirs'))]"
						align = left|nobaseline
						text = "ULUS_NO_AMIRS"
						default_format = "#subtle_name"
					}
					dynamicgridbox = {
						flipdirection = yes
						datamodel_wrap = 2
						datamodel = "[GetGlobalList('ulus_amirs')]"
						item = {
							widget = {
