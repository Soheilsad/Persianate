								size = { 235 30 }
								tooltip = "ULUS_AMIR_ROW_TT"
								country_flag_small = {
									parentanchor = left|vcenter
								}
								text_single = {
									parentanchor = left|vcenter
									position = { 42 0 }
									size = { 100 24 }
									autoresize = no
									align = left|nobaseline
									text = "[Country.GetName]"
								}
								# Weight (0-100 across the whole ulus), then
								# the share of the amirs' weight.
								text_single = {
									visible = "[And(Country.MakeScope.GetVariable('ulus_weight_eff').IsSet, Not(Country.MakeScope.GetVariable('ulus_row_lent').IsSet))]"
									parentanchor = right|vcenter
									position = { -50 0 }
									size = { 40 24 }
									autoresize = no
									align = right|nobaseline
									text = "[Country.MakeScope.GetVariable('ulus_weight_eff').GetValue|1]"
								}
								# A house whose weight stands behind another: its
								# own weight, greyed and bracketed (the hover says
								# where it went).
								text_single = {
									visible = "[Country.MakeScope.GetVariable('ulus_row_lent').IsSet]"
									parentanchor = right|vcenter
									position = { -50 0 }
									size = { 48 24 }
									autoresize = no
									align = right|nobaseline
									text = "ULUS_ROW_LENT_WEIGHT"
									default_format = "#subtle_name"
								}
								text_single = {
									visible = "[Country.MakeScope.GetVariable('ulus_amir_share').IsSet]"
									parentanchor = right|vcenter
									position = { -6 0 }
									size = { 46 24 }
									autoresize = no
									align = right|nobaseline
									text = "[Country.MakeScope.GetVariable('ulus_amir_share').GetValue|%0]"
									default_format = "#subtle_name"
								}
							}
						}
					}
				}
			}
		}

		# (3b) THE KHAN'S AUTHORITY — what a khan who keeps his seat has to
		# work with (scripted_effects/24_khan_authority_effects.txt): his
		# authority and what moves it each month, what it does to the
